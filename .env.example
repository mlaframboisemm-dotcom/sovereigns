# =========================================================================
# MARSHALL SOVEREIGN TERMINAL — ENVIRONMENT CONFIGURATION TEMPLATE
# Configure your real-world credentials here to enable live system links.
# =========================================================================

# ALLOW_PRODUCTION_SECRET_UPDATES: Explicit server-side admin flag to allow credential updates in production
ALLOW_PRODUCTION_SECRET_UPDATES=""

# GEMINI_API_KEY: Required for Gemini AI Advisor & Intelligent Report generation.
# Configure this via the Secrets panel in the Google AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: Automatically configured at runtime with the Cloud Run host URL.
APP_URL="http://localhost:3000"

# -------------------------------------------------------------------------
# SOVEREIGN ON-CHAIN SIGNING CREDENTIALS
# -------------------------------------------------------------------------

# MARSHALL_WALLET_PRIVATE_KEY: The secure Ethereum private key used by the backend
# to execute and sign on-chain transactions or transfers.
MARSHALL_WALLET_PRIVATE_KEY=""

# VITE_MARSHALL_ADDRESS: The public smart contract or multi-sig controller address.
VITE_MARSHALL_ADDRESS=""
VITE_RPC_ETHEREUM=""

# VITE_RECAPTCHA_SITE_KEY: Required for Firebase App Check reCAPTCHA v3 protection.
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# -------------------------------------------------------------------------
# EXCHANGE RECONCILIATION API CREDS
# -------------------------------------------------------------------------

# Coinbase Advanced Trade v3 (JWT-compatible keypair)
COINBASE_API_KEY_ID=""
COINBASE_API_SECRET_RAW=""

# Kraken Spot API HMAC credentials
KRAKEN_API_KEY=""
KRAKEN_API_SECRET=""

# -------------------------------------------------------------------------
# SMTP MAIL DELIVERY SETTINGS (MailerSend or others)
# -------------------------------------------------------------------------
SMTP_HOST="smtp.mailersend.net"
SMTP_PORT="587"
SMTP_USER="MS_eiFCqE@test-51ndgwv9235lzqx8.mlsender.net"
SMTP_PASS=""
MAILERSEND_API_KEY=""

# -------------------------------------------------------------------------
# UNIFIED SYSTEM SECRETS
# -------------------------------------------------------------------------
JWT_SECRET=""
SOVEREIGN_ENCRYPTION_KEY=""

# -------------------------------------------------------------------------
# ENGINE PARAMETERS
# -------------------------------------------------------------------------
ENABLE_AUTO_RECOVERY=true
ENABLE_CONSENSUS_VALIDATION=true
CONSENSUS_REQUIRED_SOURCES=2
CONSENSUS_TOLERANCE_PERCENTAGE=0.1
OPERATOR_INTERVAL_MS=30000
SOVEREIGN_RECONCILIATION_INTERVAL_MS=300000
SOVEREIGN_WALLET_SYNC_INTERVAL_MS=300000
SOVEREIGN_AUTO_TOKEN_DISCOVERY=1
SOVEREIGN_CSRF_PROTECTION=true
SOVEREIGN_DISABLE_SCHEDULERS=false
SOVEREIGN_LEDGER_PATH="./data_ledger.json"
SOVEREIGN_LEDGER_BACKUP_DIR="./ledger-backups"
SOVEREIGN_LEDGER_BACKUP_INTERVAL_MS=3600000
SOVEREIGN_LEDGER_BACKUP_MAX=20
SOVEREIGN_USE_ADVANCED_RATE_LIMITER=true
SOVEREIGN_USE_HARDWARE=false
SOVEREIGN_USE_LOCAL_KEYSTORE=false
USE_OLLAMA=false
