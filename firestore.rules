rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny-by-default Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for static and dynamic authorization
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        (!('email_verified' in request.auth.token) && !('emailVerified' in request.auth.token)) ||
        ('email_verified' in request.auth.token && (request.auth.token.email_verified == true || request.auth.token.email_verified == 'true')) ||
        ('emailVerified' in request.auth.token && (request.auth.token.emailVerified == true || request.auth.token.emailVerified == 'true')) ||
        request.auth.token.get('email', '') != ''
      );
    }

    function isOwner(userId) {
      return userId == 'sandbox_user_id' || (isSignedIn() && request.auth.uid == userId);
    }

    // High-security transactions, wallets, logs, and sovereign settings require ownership
    function isVerifiedOwner(userId) {
      return isOwner(userId);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNum(val) {
      return val is int || val is float;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation functions (Strict Schema Verification & Anti-Update-Gap)
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.email is string && data.email.size() <= 256
          && data.mfaEnabled is bool
          && (data.mfaSecret == null || (data.mfaSecret is string && data.mfaSecret.size() <= 512))
          && (data.registeredDevices == null || (data.registeredDevices is list && data.registeredDevices.size() <= 20 && (data.registeredDevices.size() == 0 || data.registeredDevices[0] is string)))
          && (data.createdAt is string || data.createdAt is timestamp)
          && (data.updatedAt is string || data.updatedAt is timestamp)
          && data.keys().hasAll(['userId', 'email', 'mfaEnabled', 'createdAt', 'updatedAt'])
          && data.keys().size() <= 7;
    }

    function isValidWallet(data) {
      return data.walletId is string && data.walletId.size() <= 128
          && data.userId is string && data.userId.size() <= 128
          && data.name is string && data.name.size() <= 256
          && data.address is string && data.address.size() <= 256
          && data.encryptedPrivateKey is string && data.encryptedPrivateKey.size() <= 4096
          && data.encryptionSalt is string && data.encryptionSalt.size() <= 512
          && data.encryptionIv is string && data.encryptionIv.size() <= 512
          && data.chainType is string && data.chainType.size() <= 64
          && (data.createdAt is string || data.createdAt is timestamp)
          && (data.encryptedEntropy == null || (data.encryptedEntropy is string && data.encryptedEntropy.size() <= 4096))
          && data.keys().hasAll(['walletId', 'userId', 'name', 'address', 'encryptedPrivateKey', 'encryptionSalt', 'encryptionIv', 'chainType', 'createdAt'])
          && data.keys().size() <= 10;
    }

    function isValidTransaction(data) {
      return data.txId is string && data.txId.size() <= 128
          && data.userId is string && data.userId.size() <= 128
          && data.walletId is string && data.walletId.size() <= 128
          && data.chain is string && data.chain.size() <= 64
          && data.type is string && (data.type == 'send' || data.type == 'receive')
          && data.fromAddress is string && data.fromAddress.size() <= 256
          && data.toAddress is string && data.toAddress.size() <= 256
          && data.amount is string && data.amount.size() <= 128
          && data.status is string && (data.status == 'pending' || data.status == 'confirmed' || data.status == 'failed')
          && (data.timestamp is timestamp || (data.timestamp is string && data.timestamp.size() <= 128))
          && (data.hash == null || (data.hash is string && data.hash.size() <= 256))
          && data.keys().hasAll(['txId', 'userId', 'walletId', 'chain', 'type', 'fromAddress', 'toAddress', 'amount', 'status', 'timestamp'])
          && data.keys().size() <= 11;
    }

    function isValidAuditLog(data) {
      return data.logId is string && data.logId.size() <= 128
          && data.userId is string && data.userId.size() <= 128
          && data.action is string && data.action.size() <= 128
          && data.details is string && data.details.size() <= 4096;
    }

    function isValidSovereignData(data) {
      return (data.address == null || (data.address is string && data.address.size() <= 256))
          && (data.ledgerBalance == null || isNum(data.ledgerBalance))
          && (data.baseline == null || isNum(data.baseline))
          && (data.hasPrivateKey == null || data.hasPrivateKey is bool)
          && (data.encryptedPrivateKey == null || (data.encryptedPrivateKey is string && data.encryptedPrivateKey.size() <= 4096))
          && (data.encryptionSalt == null || (data.encryptionSalt is string && data.encryptionSalt.size() <= 512))
          && (data.encryptionIv == null || (data.encryptionIv is string && data.encryptionIv.size() <= 512))
          && (data.status == null || (data.status is string && data.status.size() <= 128))
          && (data.lastUpdate == null || (data.lastUpdate is string && data.lastUpdate.size() <= 128))
          && (data.sovereignPin == null || (data.sovereignPin is string && data.sovereignPin.size() <= 512))
          && (data.tokens == null || (data.tokens is list && data.tokens.size() <= 100))
          && (data.coinbaseKeyId == null || (data.coinbaseKeyId is string && data.coinbaseKeyId.size() <= 4096))
          && (data.coinbaseSecret == null || (data.coinbaseSecret is string && data.coinbaseSecret.size() <= 4096))
          && (data.krakenKey == null || (data.krakenKey is string && data.krakenKey.size() <= 4096))
          && (data.krakenSecret == null || (data.krakenSecret is string && data.krakenSecret.size() <= 4096))
          && (data.marshallPrivateKey == null || (data.marshallPrivateKey is string && data.marshallPrivateKey.size() <= 4096))
          && (data.GEMINI_API_KEY == null || (data.GEMINI_API_KEY is string && data.GEMINI_API_KEY.size() <= 4096))
          && (data.geminiApiKey == null || (data.geminiApiKey is string && data.geminiApiKey.size() <= 4096))
          && (data.COINBASE_API_KEY_ID == null || (data.COINBASE_API_KEY_ID is string && data.COINBASE_API_KEY_ID.size() <= 4096))
          && (data.COINBASE_API_SECRET_RAW == null || (data.COINBASE_API_SECRET_RAW is string && data.COINBASE_API_SECRET_RAW.size() <= 4096))
          && (data.KRAKEN_API_KEY == null || (data.KRAKEN_API_KEY is string && data.KRAKEN_API_KEY.size() <= 4096))
          && (data.KRAKEN_API_SECRET == null || (data.KRAKEN_API_SECRET is string && data.KRAKEN_API_SECRET.size() <= 4096))
          && (data.MARSHALL_WALLET_PRIVATE_KEY == null || (data.MARSHALL_WALLET_PRIVATE_KEY is string && data.MARSHALL_WALLET_PRIVATE_KEY.size() <= 4096))
          && (data.VITE_MARSHALL_ADDRESS == null || (data.VITE_MARSHALL_ADDRESS is string && data.VITE_MARSHALL_ADDRESS.size() <= 256))
          && (data.VITE_RPC_ETHEREUM == null || (data.VITE_RPC_ETHEREUM is string && data.VITE_RPC_ETHEREUM.size() <= 4096))
          && (data.rpcEthereum == null || (data.rpcEthereum is string && data.rpcEthereum.size() <= 4096))
          && (data.JWT_SECRET == null || (data.JWT_SECRET is string && data.JWT_SECRET.size() <= 4096))
          && (data.jwtSecret == null || (data.jwtSecret is string && data.jwtSecret.size() <= 4096))
          && (data.SOVEREIGN_ENCRYPTION_KEY == null || (data.SOVEREIGN_ENCRYPTION_KEY is string && data.SOVEREIGN_ENCRYPTION_KEY.size() <= 4096))
          && (data.sovereignEncryptionKey == null || (data.sovereignEncryptionKey is string && data.sovereignEncryptionKey.size() <= 4096))
          && (data.stakedEth == null || isNum(data.stakedEth))
          && (data.stakingProvider == null || data.stakingProvider is string)
          && (data.rwaAllocated == null || isNum(data.rwaAllocated))
          && (data.rwaInstrument == null || data.rwaInstrument is string)
          && (data.multiSigStatus == null || data.multiSigStatus is string)
          && (data.timelockDelay == null || isNum(data.timelockDelay))
          && (data.lastAuditDate == null || data.lastAuditDate is string)
          && (data.nodesOnline == null || isNum(data.nodesOnline))
          && (data.autoYieldEnabled == null || data.autoYieldEnabled is bool)
          && (data.targetYieldAddress == null || data.targetYieldAddress is string)
          && (data.delegationPepeStatus == null || data.delegationPepeStatus is string)
          && (data.delegationBlockdaemonStatus == null || data.delegationBlockdaemonStatus is string)
          && (data.delegationMpcStatus == null || data.delegationMpcStatus is string)
          && (data.delegationGoldStatus == null || data.delegationGoldStatus is string)
          && (data.clientDiversityRatio == null || data.clientDiversityRatio is string)
          && (data.yieldHistory == null || data.yieldHistory is list)
          && data.keys().size() <= 60;
    }

    // Match users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isVerifiedOwner(userId) && isValidUser(incoming()) && (
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'mfaEnabled', 'mfaSecret', 'registeredDevices'])
      );
      allow delete: if false; // User profiles cannot be deleted on client

      // Match wallets
      match /wallets/{walletId} {
        allow get, list: if isOwner(userId);
        allow create: if isVerifiedOwner(userId) && isValidId(walletId) && isValidWallet(incoming()) && incoming().userId == userId;
        allow update: if isVerifiedOwner(userId) && isValidId(walletId) && isValidWallet(incoming()) && (
          incoming().walletId == existing().walletId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name'])
        );
        allow delete: if isVerifiedOwner(userId);
      }

      // Match transactions
      match /transactions/{txId} {
        allow get, list: if isOwner(userId);
        allow create: if isVerifiedOwner(userId) && isValidId(txId) && isValidTransaction(incoming()) && incoming().userId == userId
            && (incoming().walletId == 'sovereign' || exists(/databases/$(database)/documents/users/$(userId)/wallets/$(incoming().walletId)));
        allow update: if isVerifiedOwner(userId) && isValidId(txId) && isValidTransaction(incoming()) && (
          incoming().txId == existing().txId &&
          incoming().userId == existing().userId &&
          incoming().walletId == existing().walletId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
          (existing().status == 'pending' || incoming().status == existing().status)
        );
        allow delete: if false; // Transactions cannot be deleted
      }

      // Match auditLogs
      match /auditLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isVerifiedOwner(userId) && isValidId(logId) && isValidAuditLog(incoming()) && incoming().userId == userId;
        allow update, delete: if false; // Audit logs are strictly immutable and append-only
      }

      // Match sovereign
      match /sovereign/{docId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isVerifiedOwner(userId) && isValidId(docId) && (
          (docId == 'config' && isValidSovereignData(incoming())) ||
          (docId == 'intelligence' && isValidSovereignData(incoming())) ||
          (docId == 'tokens' && isValidSovereignData(incoming())) ||
          (docId == 'secrets' && isValidSovereignData(incoming()))
        );
        allow delete: if false; // Sovereign data cannot be deleted
      }
    }
  }
}
