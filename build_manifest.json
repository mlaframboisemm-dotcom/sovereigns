{
  "projectName": "Marshall Sovereign Terminal",
  "releaseVersion": "1.0.0",
  "targetHost": "sovereigns.ca",
  "buildConfiguration": {
    "engine": "esbuild (Node.js backend) & Vite (React TS frontend)",
    "targetPlatform": "Node.js v18+",
    "type": "module",
    "entrypoints": {
      "client": "index.html",
      "server": "server.ts",
      "electronMain": "src/main.js",
      "electronPreload": "src/preload.js"
    },
    "outputs": {
      "clientBundle": "dist/",
      "serverBundle": "dist/server.cjs"
    }
  },
  "directoryMapping": {
    "src": "src/ (main/preload Electron logic and React app components)",
    "config": "config/ (Firestore security rules and firebase configurations)",
    "audit": "audit/ (Marshall Effect forensic reconciliation engines)",
    "api": "api/ (Interac e-Transfer disbursement and settlement rails)",
    "ledger": "ledger/ (USD liquidity tracking and transaction books)"
  },
  "securityCompliance": {
    "electron": {
      "contextIsolation": true,
      "sandbox": true,
      "nodeIntegration": false,
      "webSecurity": true,
      "ipcWhitelisting": ["ledger:sync", "withdrawal:initiate", "audit:status"]
    },
    "firestore": {
      "rulesetVersion": "2",
      "rbacMode": "strict-ownership",
      "dataInvariants": [
        "User Profile matching request.auth.uid",
        "Wallet matching Owner UID",
        "Append-Only Audit Logs",
        "Sovereign Treasury Isolation"
      ]
    }
  }
}
