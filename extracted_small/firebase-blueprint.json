{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and security settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID matching Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "mfaEnabled": { "type": "boolean", "description": "Whether Multi-Factor Authentication is enabled" },
        "mfaSecret": { "type": "string", "description": "Encrypted MFA secret if enabled" },
        "registeredDevices": { "type": "array", "description": "List of trusted devices and sessions" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Profile creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Profile last update timestamp" }
      },
      "required": ["userId", "email", "mfaEnabled", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Secure encrypted wallet metadata",
      "type": "object",
      "properties": {
        "walletId": { "type": "string", "description": "Unique wallet identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "User-assigned name for this wallet" },
        "address": { "type": "string", "description": "Public blockchain address" },
        "encryptedEntropy": { "type": "string", "description": "AES-GCM encrypted seed phrase/entropy" },
        "encryptedPrivateKey": { "type": "string", "description": "AES-GCM encrypted private key" },
        "encryptionSalt": { "type": "string", "description": "Hex encoded salt used in PBKDF2 key derivation" },
        "encryptionIv": { "type": "string", "description": "Hex encoded IV used for AES-GCM encryption" },
        "chainType": { "type": "string", "description": "Blockchain type (e.g., EVM, Solana, Bitcoin)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Wallet creation timestamp" }
      },
      "required": ["walletId", "userId", "name", "address", "encryptedPrivateKey", "encryptionSalt", "encryptionIv", "chainType", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Recorded blockchain transaction metadata",
      "type": "object",
      "properties": {
        "txId": { "type": "string", "description": "Unique transaction identifier (often tx hash)" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "walletId": { "type": "string", "description": "Associated wallet ID" },
        "chain": { "type": "string", "description": "Blockchain network (e.g., Ethereum, Polygon, Base)" },
        "type": { "type": "string", "enum": ["send", "receive"], "description": "Transaction direction" },
        "fromAddress": { "type": "string", "description": "Sender blockchain address" },
        "toAddress": { "type": "string", "description": "Recipient blockchain address" },
        "amount": { "type": "string", "description": "Transaction amount in native crypto unit" },
        "hash": { "type": "string", "description": "On-chain transaction hash" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "failed"], "description": "Transaction status" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Transaction broadcast timestamp" }
      },
      "required": ["txId", "userId", "walletId", "chain", "type", "fromAddress", "toAddress", "amount", "status", "timestamp"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security audit log entry",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "description": "Unique log identifier" },
        "userId": { "type": "string", "description": "User ID who performed the action" },
        "action": { "type": "string", "description": "Action performed (e.g., WALLET_CREATED, COIN_SENT)" },
        "details": { "type": "string", "description": "Detailed metadata or description of the action" },
        "ipAddress": { "type": "string", "description": "User IP address or approximate location" },
        "userAgent": { "type": "string", "description": "Browser user agent" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Action timestamp" }
      },
      "required": ["logId", "userId", "action", "details", "userAgent", "timestamp"]
    },
    "SovereignData": {
      "title": "SovereignData",
      "description": "Sovereign state database document",
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "ledgerBalance": { "type": "number" },
        "baseline": { "type": "number" },
        "hasPrivateKey": { "type": "boolean" },
        "encryptedPrivateKey": { "type": "string" },
        "encryptionSalt": { "type": "string" },
        "encryptionIv": { "type": "string" },
        "status": { "type": "string" },
        "lastUpdate": { "type": "string" },
        "sovereignPin": { "type": "string" },
        "tokens": { "type": "array" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account profile document"
    },
    "/users/{userId}/wallets/{walletId}": {
      "schema": "Wallet",
      "description": "User's encrypted wallets"
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": "Transaction",
      "description": "User's recorded transaction history"
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only user security audit logs"
    },
    "/users/{userId}/sovereign/{docId}": {
      "schema": "SovereignData",
      "description": "User's Sovereign treasury configuration and tokens"
    }
  }
}
