rules_version = '2';
service cloudfirestore {
  match /databases/{database}/documents {
    // Default-deny catch-all (First rule block)
    match /{document=**} {
      allow read, write: if false;
    }

    // Check if the user is authenticated and is the owner of the user path
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection and its Subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Wallets Subcollection
      match /wallets/{walletId} {
        allow read, write: if isOwner(userId);
      }

      // Transactions Subcollection
      match /transactions/{txId} {
        allow read, write: if isOwner(userId);
      }

      // Audit Logs Subcollection
      match /auditLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Sovereign Subcollection
      match /sovereign/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
